# Все значения вписываются в App Platform → Переменные окружения. Сам этот файл на сервер не нужен.

# Адрес сайта, с https и без слеша в конце
SITE_URL=https://protest-style.ru
# Пароль админки (не короче 12 символов) — им же включаются уведомления в боте: /admin пароль
ADMIN_PASSWORD=

# Хранилище S3 Timeweb
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# публичный бакет для фото и видео
S3_BUCKET=
# закрытый бакет для товаров и заказов
S3_DATA_BUCKET=

# Telegram-бот от @BotFather
TG_BOT_TOKEN=
# канал, из которого брать посты (необязательно): @protest_style
TG_CHANNEL=

# ИИ для разбора постов и переводов (любой OpenAI-совместимый API). Без него работает разбор по правилам
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

BASE_CURRENCY=RUB
